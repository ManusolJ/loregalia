{
  "name": "loregalia",
  "version": "0.1.0",
  "scripts": {
    "build": "ng build",
    "start": "ng serve",
    "tauri": "tauri",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "create-interface": "ng generate interface --path=src/app/shared/models",
    "create-feature": "ng generate component --skip-tests true --path=src/app/features",
    "create-service": "ng generate service --skip-tests true --path=src/app/core/services",
    "create-component": "ng generate component --skip-tests true --path=src/app/shared/components"
  },
  "private": true,
  "dependencies": {
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "@tauri-apps/api": "^2",
    "@angular/core": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/common": "^22.0.1",
    "@angular/router": "^22.0.1",
    "@angular/compiler": "^22.0.1",
    "@tauri-apps/plugin-opener": "^2",
    "@angular/platform-browser": "^22.0.1"
  },
  "devDependencies": {
    "jsdom": "^30.1.2",
    "vitest": "^5.0.3",
    "eslint": "^10.12.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "@eslint/js": "^10.0.1",
    "tailwindcss": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@angular/cli": "^22.0.1",
    "angular-eslint": "^22.5.0",
    "@angular/build": "^22.0.1",
    "typescript-eslint": "^8.71.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@angular/compiler-cli": "^22.0.1",
    "@angular-eslint/builder": "^22.5.0",
    "eslint-plugin-perfectionist": "^5.12.1"
  }
}
